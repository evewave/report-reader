# 复制为 .env 后填写。.env 已被 .gitignore 忽略，不会提交，也不上云。

# 必填：OpenAI API Key
OPENAI_API_KEY=

# 可选：中转/兼容网关地址（留空则用官方 https://api.openai.com/v1）
OPENAI_BASE_URL=

# 可选：模型名（默认 gpt-4o，具备文本+视觉能力；纯文本可用 gpt-4o-mini 更省）
OPENAI_MODEL=gpt-4o
# 视觉模型（图表识别），留空则复用 OPENAI_MODEL
OPENAI_VISION_MODEL=gpt-4o

# 可选：采样温度与超时（秒）
OPENAI_TEMPERATURE=0.2
OPENAI_TIMEOUT=180

# 可选：服务绑定（默认只监听本机）
RR_HOST=127.0.0.1
RR_PORT=8000
# 逐页渲染分辨率与正文喂给模型的上限字符数
RR_RENDER_DPI=120
RR_MAX_TEXT_CHARS=60000
